# ─────────────────────────────────────────────────────────────────────
# STREAMLIT CLOUD: paste the WHOLE block below (both lines) into
#   App → ⋮ → Settings → Secrets
#
#   [database]
#   url = "postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
#
# Pasting only the bare URL does NOT work — that box expects TOML, and a
# raw `postgresql://...` line is invalid TOML (the ':' is parsed as a key
# name). The [database] header and the quoted `url =` key are both required.
# ─────────────────────────────────────────────────────────────────────
#
# Copy this file to `.streamlit/secrets.toml` and fill in real values.
# `.streamlit/secrets.toml` is gitignored — never commit it, and never paste a
# real connection URL into chat, a PR, or an issue. It contains the DB password.
#
# On Streamlit Community Cloud these same keys go in:
#   App → ⋮ → Settings → Secrets  (paste the TOML, not the file)

[database]
# Supabase → Project Settings → Database → Connection string → URI.
#
# PREFER THE TRANSACTION POOLER (port 6543). Streamlit reruns constantly and
# opens many short-lived connections; the free tier's direct-connection cap is
# low, and PgBouncer already pools, so db.py uses NullPool for this URL.
#   postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#
# Direct connection (port 5432) also works — db.py detects it and switches to
# a QueuePool with pre-ping instead.
url = "postgresql+psycopg2://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"

# Leave `url` unset (or delete this whole section) to run on local SQLite at
# data/ngis.db — that is the default and needs no configuration at all.


# Gemini OCR key — supplied server-side, never entered in the UI. The app reads
# [gemini].api_key first, then the GEMINI_API_KEY env var; if neither is set,
# OCR is simply disabled and the rest of the register still works. Get a key at
# https://aistudio.google.com/apikey . Like the DB URL, this is a secret —
# never commit `.streamlit/secrets.toml` or paste the key into chat/PRs.
[gemini]
api_key = "AIza..."
